{
  "name": "codex-micro-ajazz",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "Codex Micro protocol core, AJAZZ and Stream Deck adapters with an RP2040 USB bridge.",
  "exports": {
    ".": "./protocol/index.js",
    "./descriptors": "./protocol/descriptors/index.js"
  },
  "scripts": {
    "test": "node --test tests/protocol/*.test.js",
    "inventory": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/inventory-windows.ps1",
    "preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/preflight-device-test.ps1",
    "verify:descriptor": "node tools/verify-descriptor.mjs",
    "doctor:build": "dotnet build tools/ajazz-doctor/AjazzDoctor.csproj -c Release",
    "doctor": "dotnet run --project tools/ajazz-doctor/AjazzDoctor.csproj -c Release --no-build -- --vid 0300 --pid 3002",
    "hardware:build": "cargo build --manifest-path tools/ajazz-hardware-test/Cargo.toml --release --offline",
    "hardware:test": "cargo run --manifest-path tools/ajazz-hardware-test/Cargo.toml --release --offline --",
    "rp2040:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-rp2040-toolchain.ps1",
    "rp2040:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-rp2040-toolchain.ps1",
    "rp2040:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-rp2040.ps1",
    "rp2040:verify": "node tools/verify-rp2040-artifact.mjs",
    "rp2040:flash": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/flash-rp2040.ps1",
    "rp2040:port": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/find-rp2040-port.ps1",
    "firmware:host-test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-firmware-host.ps1",
    "firmware:flash": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/flash-firmware.ps1",
    "bridge:build": "cargo build --manifest-path tools/rp2040-bridge/Cargo.toml --release --offline",
    "bridge:test": "cargo test --manifest-path tools/rp2040-bridge/Cargo.toml --offline",
    "bridge:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-bridge.ps1",
    "bridge:run": "cargo run --quiet --manifest-path tools/rp2040-bridge/Cargo.toml --release --offline --",
    "bridge:daemon": "cargo run --quiet --manifest-path tools/rp2040-bridge/Cargo.toml --release --offline -- --daemon --port auto",
    "bridge:daemon:standalone": "cargo run --quiet --manifest-path tools/rp2040-bridge/Cargo.toml --release --offline -- --daemon --port none",
    "bridge:proxy:codex": "cargo run --quiet --manifest-path tools/rp2040-bridge/Cargo.toml --release --offline -- --mcp-proxy --agent codex --autostart",
    "bridge:proxy:zcode": "cargo run --quiet --manifest-path tools/rp2040-bridge/Cargo.toml --release --offline -- --mcp-proxy --agent zcode --autostart",
    "bridge:proxy:hermes": "cargo run --quiet --manifest-path tools/rp2040-bridge/Cargo.toml --release --offline -- --mcp-proxy --agent hermes --autostart",
    "plugin:install": "npm --prefix plugin/streamdeck install",
    "plugin:build": "npm --prefix plugin/streamdeck run build",
    "plugin:watch": "npm --prefix plugin/streamdeck run watch",
    "plugin:link": "npm --prefix plugin/streamdeck run link",
    "plugin:pack": "npm --prefix plugin/streamdeck run pack",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-windows-release.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
