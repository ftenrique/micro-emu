[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 07/29/2026,0.1.0.0
CatalogFile = CodexMicroVhf.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
CodexMicroVhf.sys = 1

[Manufacturer]
%ProviderName% = Models,NTamd64

[Models.NTamd64]
%DeviceDescription% = CodexMicroVhf_Install,ROOT\CODEXMICROVHF

[CodexMicroVhf_Install.NT]
CopyFiles = DriverCopyFiles

[DriverCopyFiles]
CodexMicroVhf.sys

[CodexMicroVhf_Install.NT.HW]
AddReg = CodexMicroVhf_LowerFilter

[CodexMicroVhf_LowerFilter]
HKR,,"LowerFilters",0x00010000,"vhf"

[CodexMicroVhf_Install.NT.Services]
AddService = CodexMicroVhf,0x00000002,CodexMicroVhf_Service

[CodexMicroVhf_Service]
DisplayName    = %ServiceDescription%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\CodexMicroVhf.sys

[CodexMicroVhf_Install.NT.Wdf]
KmdfService = CodexMicroVhf,CodexMicroVhf_Wdf

[CodexMicroVhf_Wdf]
KmdfLibraryVersion = 1.15

[Strings]
ProviderName       = "micro-emu contributors"
DiskName           = "Codex Micro VHF Spike Installation Disk"
DeviceDescription  = "Codex Micro VHF Feasibility Spike"
ServiceDescription = "Codex Micro Virtual HID Source Driver"
