{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "device-profile.schema.json",
  "title": "AJAZZ device profile",
  "type": "object",
  "required": [
    "profileVersion",
    "status",
    "model",
    "transport",
    "interfaces",
    "lcd",
    "controls",
    "evidence"
  ],
  "properties": {
    "profileVersion": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["pending-hardware", "observed", "verified"]
    },
    "model": { "type": "string", "minLength": 1 },
    "revision": { "type": ["string", "null"] },
    "vendorId": { "type": ["string", "null"], "pattern": "^0x[0-9A-Fa-f]{4}$" },
    "productId": { "type": ["string", "null"], "pattern": "^0x[0-9A-Fa-f]{4}$" },
    "firmware": { "type": ["string", "null"] },
    "transport": { "type": "string" },
    "interfaces": { "type": "array", "items": { "type": "object" } },
    "inputReportBytes": { "type": ["integer", "null"], "minimum": 1 },
    "outputReportBytes": { "type": ["integer", "null"], "minimum": 1 },
    "featureReportBytes": { "type": ["integer", "null"], "minimum": 1 },
    "lcd": { "type": "object" },
    "controls": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
